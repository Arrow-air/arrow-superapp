{
  "name": "spec-threads",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "start": "serve -s dist -l ${PORT:-3000}",
    "e2e": "node scripts/e2e.mjs",
    "e2e:conversation": "node e2e/conversation.cjs",
    "e2e:records": "node e2e/records.cjs",
    "e2e:samples": "node e2e/samples.cjs",
    "e2e:briefing": "node e2e/briefing.cjs",
    "e2e:shared": "node scripts/run-acceptance.mjs",
    "build:shared": "VITE_PROJECT_DATA=spearhead VITE_BACKEND=shared vite build --outDir dist-shared && node scripts/build-server.mjs",
    "build:evidence": "VITE_PROJECT_DATA=spearhead VITE_BACKEND=demo vite build --outDir dist-real-next",
    "server:start": "node scripts/service.mjs start",
    "server:restart": "node scripts/service.mjs restart",
    "backup": "node scripts/backup.mjs",
    "demo:seed": "esbuild server/demo-seed.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=.runtime/demo-seed.mjs --log-level=warning && node .runtime/demo-seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "dompurify": "^3.2.0",
    "marked": "^15.0.0",
    "pg": "^8.23.0",
    "serve": "^14.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "prettier": "3.6.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  }
}
